# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Brave Search (optional) — https://brave.com/search/api/
BRAVE_API_KEY=your-brave-search-api-key

# User contact information
BENE_USER_PHONE=+15551234567
BENE_USER_NAME=YourName

# LangSmith tracing — https://smith.langchain.com/
# Set LANGCHAIN_TRACING_V2=true to enable tracing (set to false to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=your-langsmith-project          # project name shown in LangSmith UI
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # default, no need to change
